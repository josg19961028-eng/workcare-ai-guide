<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    namespace는 이 SQL을 사용할 Mapper 인터페이스의
    전체 패키지명과 정확히 일치해야 한다.
-->
<mapper namespace="egovframework.workcare.common.infrastructure.DatabaseProbeMapper">

    <!--
        id는 Mapper 인터페이스의 메서드명과 정확히 일치해야 한다.

        Oracle의 DUAL은 실제 업무 데이터가 없는 가상 테이블이다.
        따라서 DB 연결 여부를 가볍게 확인할 때 사용할 수 있다.
    -->
    <select id="selectConnectionCheck"
            resultType="int">
        SELECT 1
          FROM DUAL
    </select>

</mapper>